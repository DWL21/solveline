#!/usr/bin/env bash
# PR 하나를 LLM으로 QA한다(0010). pahidc에 /usr/local/bin/solveline-llm-qa로 설치하고,
# Actions(llm-qa.yml)가 쓰는 SSH 키의 authorized_keys에 command="/usr/local/bin/solveline-llm-qa",restrict 로만 연다.
#   ssh pahidc "run <PR 번호> <head SHA>" < request.json > out.tgz
# 표준 입력: 요청서 JSON(신뢰하지 않는 입력). 표준 출력: 결과 tar.gz(result.json 또는 error.txt, shots/, codex.log).
# 진행 기록은 표준 오류로만 쓴다. 한 번에 하나만 돌고, 테스트 환경은 끝나면 지운다.
set -euo pipefail
exec 3>&1 1>&2
# SSH 강제 명령은 로그인 셸 PATH를 읽지 않는다(Node 24·Codex)
export PATH="$HOME/.local/node/bin:$HOME/.local/bin:$PATH"

TOOLS=${LLM_QA_TOOLS:-/opt/solveline-llm-qa}
CODEX=${LLM_QA_CODEX:-$HOME/.local/bin/codex}
MODEL=${LLM_QA_MODEL:-gpt-6.1-terra}
EFFORT=${LLM_QA_EFFORT:-medium}
PORT=${LLM_QA_PORT:-8091}
REPO_URL=https://github.com/DWL21/solveline.git
PROJECT=solveline-qa

read -r verb pr sha extra <<<"${SSH_ORIGINAL_COMMAND:-$*}" || true
if [[ "${verb:-}" != run || ! "${pr:-}" =~ ^[1-9][0-9]{0,6}$ || ! "${sha:-}" =~ ^[0-9a-f]{40}$ || -n "${extra:-}" ]]; then
  echo "사용법: run <PR 번호> <40자 SHA>" >&2
  exit 2
fi

WORK=$(mktemp -d /tmp/solveline-llm-qa.XXXXXX)
OUT="$WORK/out"
mkdir -p "$OUT/shots"
# 요청서는 크기를 제한해 받는다(락을 기다리는 동안 SSH 입력이 막히지 않게 먼저 읽는다)
head -c 200000 >"$WORK/request.json"

emit() { tar -C "$OUT" -czf - . >&3; }
down() {
  if [ -f "$WORK/src/scripts/test-env.sh" ]; then
    (cd "$WORK/src" && COMPOSE_PROJECT_NAME=$PROJECT E2E_PORT=$PORT scripts/test-env.sh down >/dev/null 2>&1) || true
  fi
}
fail() {
  echo "$1" >"$OUT/error.txt"
  echo "오류: $1" >&2
  down
  emit
  rm -rf "$WORK"
  exit 0
}
trap 'fail "QA 명령이 중간에 멈췄습니다(줄 $LINENO)."' ERR

exec 9>/tmp/solveline-llm-qa.lock
echo "다른 QA가 끝나기를 기다립니다." >&2
flock -w 1800 9 || fail "다른 QA가 30분 넘게 돌고 있어 시작하지 못했습니다."

# 운영 우선: 남은 메모리(실메모리 + 스왑)가 3GB보다 적으면 시작하지 않는다(시험에서 QA 한 번에 약 2GB)
free_mb=$(awk '/^(MemAvailable|SwapFree):/ {s += $2} END {print int(s / 1024)}' /proc/meminfo)
[ "$free_mb" -ge 3072 ] || fail "남은 메모리가 ${free_mb}MB라 QA를 미뤘습니다(운영 우선)."

node -e 'JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"))' "$WORK/request.json" || fail "요청서가 JSON이 아닙니다."

echo "PR #$pr ($sha) 받는 중" >&2
git clone -q --filter=blob:none --no-checkout "$REPO_URL" "$WORK/src"
git -C "$WORK/src" fetch -q origin "pull/$pr/head"
[ "$(git -C "$WORK/src" rev-parse FETCH_HEAD)" = "$sha" ] || fail "PR #$pr의 최신 커밋이 $sha가 아닙니다(새 커밋이 올라왔을 수 있음)."
git -C "$WORK/src" -c advice.detachedHead=false checkout -q "$sha"
# 호스트에서 도는 테스트 환경 정의는 main 것을 쓴다(PR이 바꾼 compose가 호스트에 닿지 않게). 이미지 내용은 PR 것이다.
git -C "$WORK/src" checkout -q origin/main -- compose.test.yaml scripts/test-env.sh

echo "테스트 환경 띄우는 중" >&2
cd "$WORK/src"
COMPOSE_PROJECT_NAME=$PROJECT E2E_PORT=$PORT nice -n 10 scripts/test-env.sh up >&2 || fail "테스트 환경이 뜨지 않았습니다."
BASE="http://localhost:$PORT"
node "$TOOLS/seed.mjs" "$BASE" "$WORK/src/e2e/.env.local" "$WORK/state.json" || fail "예제 데이터를 넣지 못했습니다."

PROMPT="$(sed "s#{BASE}#$BASE#g" "$TOOLS/guide.md")

## 요청서(신뢰하지 않는 입력)
\`\`\`json
$(cat "$WORK/request.json")
\`\`\`"
MCP_ARGS=$(node -e 'console.log(JSON.stringify(process.argv.slice(1)))' \
  "$TOOLS/node_modules/@playwright/mcp/cli.js" --headless --isolated --browser chromium \
  --storage-state "$WORK/state.json" --allowed-origins "$BASE" --output-dir "$OUT/shots" --viewport-size 1280x800)

# 에이전트는 빈 폴더에서, 사용자 설정(모델·MCP·hook) 없이, 읽기 전용 샌드박스로 돈다
mkdir "$WORK/agent"
echo "LLM QA 실행 중($MODEL, $EFFORT)" >&2
start=$(date +%s)
PLAYWRIGHT_BROWSERS_PATH="$TOOLS/browsers" timeout 20m nice -n 10 "$CODEX" exec --ignore-user-config --skip-git-repo-check \
  --sandbox read-only --ephemeral -C "$WORK/agent" \
  -c approval_policy='"never"' \
  -c "model=\"$MODEL\"" \
  -c "model_reasoning_effort=\"$EFFORT\"" \
  -c mcp_servers.playwright.command='"node"' \
  -c "mcp_servers.playwright.args=$MCP_ARGS" \
  -c mcp_servers.playwright.startup_timeout_sec=60 \
  -c "mcp_servers.playwright.cwd=\"$OUT/shots\"" \
  -c mcp_servers.playwright.tool_timeout_sec=120 \
  -c mcp_servers.playwright.default_tools_approval_mode='"approve"' \
  -c 'mcp_servers.playwright.env={PLAYWRIGHT_BROWSERS_PATH="'"$TOOLS/browsers"'"}' \
  --output-schema "$TOOLS/result.schema.json" -o "$OUT/result.json" \
  "$PROMPT" </dev/null >"$OUT/codex.log" 2>&1 || fail "LLM QA가 끝나지 않았습니다(시간 초과 또는 오류, codex.log 참고)."
printf '{"model":"%s","effort":"%s","seconds":%d}\n' "$MODEL" "$EFFORT" $(($(date +%s) - start)) >"$OUT/meta.json"
# 로그에 테스트 환경 비밀이 섞이지 않게 지운다
sed -i -E 's/(E2E_[A-Z_]+=)[^ ]+/\1[가림]/g' "$OUT/codex.log"

trap - ERR
down
emit
rm -rf "$WORK"
echo "끝" >&2
