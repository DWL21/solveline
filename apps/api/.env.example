# 이 파일에는 이름과 설명만 둔다. 실제 값은 다음 위치에만 저장한다.
#   로컬: apps/api/.env  (gitignore, 권한 600)
#   운영: GitHub Environment "production" secrets/variables → 배포 시 서버 /etc/solveline/api.env (root, 600)
#   새 변수는 .github/workflows/deploy.yml의 env·KEYS에도 추가해야 서버에 반영된다.

# ─── 로그인·권한 ───
# Google OAuth 클라이언트 (Google Cloud Console → API 및 서비스 → 사용자 인증 정보)
#   승인된 리디렉션 URI: <WEB_ORIGIN>/api/auth/google/callback
GOOGLE_CLIENT_ID=
# — secrets
GOOGLE_CLIENT_SECRET=
# 운영자 Google 이메일: 처음 가입하면 편집 권한을 갖고, 비밀번호 로그인 시절의 풀이 기록을 넘겨받는다 — variables
OWNER_EMAIL=
# 약관·개인정보처리방침에 적는 문의 이메일(없으면 OWNER_EMAIL) — variables (선택)
CONTACT_EMAIL=
# 관리자 모드(/admin) 마스터 비밀번호 (24자 이상 랜덤 문자열, 예: openssl rand -base64 24 | tr '+/' '-_' | tr -d '=') — secrets
ACCESS_PASSWORD=
# 세션 쿠키 서명용 랜덤 문자열 (openssl rand -base64 48) — secrets
SESSION_SECRET=
# 세션 유지 기간(일). 기본 30 — variables (선택)
SESSION_TTL_DAYS=
# 웹 출처 (CORS·쿠키), 예: https://solveline.simplyimg.com
WEB_ORIGIN=http://localhost:5173

# ─── 실행 서버 ───
# runner 주소. 운영은 compose가 http://runner:8000 으로 넣는다.
RUNNER_URL=http://127.0.0.1:8000

# ─── 카탈로그 R2 게시 (docs/decisions/0006) ───
# 넷 다 있어야 켜진다. 없으면 문제·테스트셋은 SQLite·로컬 파일에만 두고 Worker는 API에서 읽어 캐시한다.
# 처음 켜고 시작하면 문제 전체와 히든 테스트셋을 R2로 올린다(데이터 이전) — 운영자 승인 후에만 설정한다.
# Cloudflare 계정 ID, 버킷 이름 — variables
R2_ACCOUNT_ID=
R2_BUCKET=
# R2 API 토큰(해당 버킷 Object Read & Write만) — secrets
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# 위 R2 키 대신 Pages Worker의 R2 바인딩을 거쳐 게시할 때 쓰는 공유 비밀(32자 이상). Pages 비밀 R2_PROXY_SECRET과 같은 값 — secrets
R2_PROXY_SECRET=

PORT=8787
