{
  "name": "@solveline/e2e",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "API·UI 자동화 테스트(Playwright). docs/quality/README.md 참고",
  "scripts": {
    "typecheck": "tsc -p .",
    "e2e": "playwright test",
    "e2e:api": "playwright test --project=api",
    "e2e:ui": "playwright test --project=desktop-chromium --project=desktop-webkit --project=mobile-iphone --project=mobile-pixel --project=tablet-ipad",
    "e2e:ci": "playwright test --project=api --project=desktop-chromium --project=desktop-webkit --project=mobile-iphone --project=mobile-pixel --project=tablet-ipad",
    "e2e:smoke": "playwright test --project=smoke",
    "report": "playwright show-report reports/html",
    "qa-report": "node report/build.mjs"
  },
  "dependencies": {
    "@solveline/shared": "workspace:*",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}
